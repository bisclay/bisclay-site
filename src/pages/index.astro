---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import { sortRadovi } from '../lib/radovi';
import site from '../data/site.json';
import pocetna from '../data/pocetna.json';

const radovi = sortRadovi(await getCollection('radovi'));
const istaknuti = radovi.filter((r) => r.data.istaknuto).slice(0, 3);
const izbor = istaknuti.length > 0 ? istaknuti : radovi.slice(0, 3);

// Hero slika: ako je postavljena u CMS-u, koristi nju; inače prvi istaknuti rad.
const heroImage =
  (pocetna.heroSlika && pocetna.heroSlika.trim()) || izbor[0]?.data.naslovnica;

const dostupno = radovi.filter((r) => r.data.status === 'dostupno').length;
---

<Base description={site.opis} image={heroImage || undefined}>
  <section class="wrap hero">
    <div>
      <p class="eyebrow">{pocetna.heroNadnaslov || site.uloga}</p>
      <h1 class="hero__title">{pocetna.heroNaslov}</h1>
      <p class="hero__text">{pocetna.heroTekst}</p>
      <div class="button-row">
        <a class="button button--solid" href="/galerija/">{pocetna.gumb1}</a>
        <a class="button" href="/kontakt/">{pocetna.gumb2}</a>
      </div>
      {
        dostupno > 0 && (
          <p class="price-note" style="margin-top:1.5rem">
            Trenutno dostupno: {dostupno}{' '}
            {dostupno === 1 ? 'rad' : dostupno < 5 ? 'rada' : 'radova'}
          </p>
        )
      }
    </div>
    {
      heroImage && (
        <div class="hero__media">
          <img
            src={heroImage}
            alt={izbor[0]?.data.naziv ?? ''}
            width="800"
            height="1000"
            fetchpriority="high"
          />
        </div>
      )
    }
  </section>

  {
    izbor.length > 0 && (
      <>
        <hr class="rule" />
        <section class="wrap section">
          <div
            style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:2rem"
          >
            <h2 style="margin:0">{pocetna.izborNaslov}</h2>
            <a class="button button--ghost" href="/galerija/">
              {pocetna.izborVeza} &rarr;
            </a>
          </div>
          <ul class="grid">
            {izbor.map((rad) => (
              <li>
                <PieceCard rad={rad} />
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  <hr class="rule" />
  <section class="wrap section">
    <div
      style="display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr))"
    >
      <div>
        <h2>{pocetna.blok1Naslov}</h2>
        <p class="lede">{pocetna.blok1Tekst}</p>
        <a class="button" href="/o-meni/">{pocetna.blok1Gumb}</a>
      </div>
      <div>
        <h2>{pocetna.blok2Naslov}</h2>
        <p class="lede">{pocetna.blok2Tekst}</p>
        <a class="button" href="/kontakt/">{pocetna.blok2Gumb}</a>
      </div>
    </div>
  </section>
</Base>
